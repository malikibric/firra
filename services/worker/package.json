{
  "name": "@firra/worker",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "uv run --env-file ../../.env uvicorn --factory firra.app:create_app --reload --port 8081",
    "lint": "uv run ruff check . && uv run ruff format --check .",
    "typecheck": "uv run mypy --config-file ../../pyproject.toml firra tests",
    "test": "uv run pytest",
    "test:integration": "uv run pytest -m integration"
  }
}
