{
  "name": "@firra/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=../../.env src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --exclude 'test/integration/**'",
    "test:integration": "vitest run test/integration"
  },
  "dependencies": {
    "@firra/contracts": "workspace:*",
    "@firra/db-types": "workspace:*",
    "@google-cloud/tasks": "^7.2.0",
    "@hono/node-server": "^2.1.1",
    "@modelcontextprotocol/hono": "2.0.1",
    "@modelcontextprotocol/server": "2.1.0",
    "@sentry/node": "^11.0.0",
    "@supabase/supabase-js": "^2.117.2",
    "google-auth-library": "^11.1.0",
    "hono": "^4.13.9",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@firra/config": "workspace:*",
    "@types/node": "^24.19.0",
    "eslint": "^10.11.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^5.0.2"
  }
}
