# Firra environment variables. Copy to .env for local development (`cp .env.example .env`).
# .env is git-ignored. Staging/prod values live in GCP Secret Manager and Cloud Run config
# (see infra/terraform and docs/runbooks/staging-setup.md). Never commit real values.
#
# Local Supabase keys are printed by `pnpm exec supabase status`.

# --- shared -------------------------------------------------------------------------------
# local | test | staging | prod
FIRRA_ENV=local

# --- Supabase, mail and monitoring (read by apps/api; the Mac app is the only UI) ------------
SUPABASE_URL=http://127.0.0.1:54321
# Publishable (anon) key, public by design: apps/api reads as the caller with it, and the Mac app is
# built with it (apps/mac/scripts/package.sh).
SUPABASE_PUBLISHABLE_KEY=
# Optional: invite emails via Resend. Without them, invite links are shown in the UI only.
RESEND_API_KEY=
EMAIL_FROM=
# Optional: Sentry EU-region DSN (https://...ingest.de.sentry.io/...).
SENTRY_DSN=

# --- apps/api (Hono) ------------------------------------------------------------------------
PORT=8080
# Secret (service-role) key. Server-side only: apps/api and services/worker.
SUPABASE_SECRET_KEY=
API_URL=http://127.0.0.1:8080
WORKER_URL=http://127.0.0.1:8081
# local = direct HTTP to the worker (local/test only); cloud_tasks = Google Cloud Tasks.
TASK_QUEUE_MODE=local
# >= 32 random characters; must equal FIRRA_LOCAL_TASK_SECRET. Generate: openssl rand -hex 32
LOCAL_TASK_SECRET=
# cloud_tasks mode only:
GCP_PROJECT_ID=
GCP_REGION=europe-west3
TASKS_INVOKER_SA_EMAIL=
# Comma-separated service accounts allowed to call /internal/* (deploy smoke test).
INTERNAL_CALLER_SA_EMAILS=
RATE_LIMIT_PER_MINUTE=120
# Per authenticated user on /v1 read routes
USER_RATE_LIMIT_PER_MINUTE=300
# Remote MCP (POST /mcp): per personal access token, and browser origins allowed to call it
# (comma-separated; empty = browser origins refused, non-browser clients need none).
MCP_RATE_LIMIT_PER_MINUTE=120
MCP_ALLOWED_ORIGINS=
# Optional legacy web origin; leave unset for Mac-only operation.
WEB_URL=
# Google OAuth client for Gmail connections (optional locally).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Microsoft Entra app for Outlook connections (optional locally). Redirect URI:
# <API_URL>/oauth/microsoft/callback. Tenant: organizations (default) | common | <tenant id>.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=organizations
# Numeric client id of the worker service account, shown for Google domain-wide delegation.
WORKER_SA_CLIENT_ID=
# Mail export uploads: RAW_BUCKET in staging/prod (set by Terraform); locally LOCAL_RAW_DIR, an
# absolute path equal to the worker's FIRRA_LOCAL_RAW_DIR so the worker finds the files.
RAW_BUCKET=
LOCAL_RAW_DIR=
# Service account Pub/Sub uses to sign Gmail push requests to /webhooks/gmail (staging/prod).
GMAIL_PUSH_SA_EMAIL=
# Token-encryption KEK: local (static key, local/test only) | cloud (Cloud KMS).
KMS_MODE=local
# local mode: 64 hex characters, must equal FIRRA_LOCAL_KEK_HEX so api and worker share keys.
LOCAL_KEK_HEX=
# cloud mode: projects/<p>/locations/europe-west3/keyRings/firra/cryptoKeys/token-kek
KMS_KEY_NAME=
RELEASE=dev

# --- services/worker (FastAPI) --------------------------------------------------------------
FIRRA_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# oidc (staging/prod) | local_secret (local/test only)
FIRRA_TASK_AUTH_MODE=local_secret
FIRRA_LOCAL_TASK_SECRET=
# Where the local worker reaches itself for continuations of long jobs (local/test only).
FIRRA_LOCAL_WORKER_URL=http://127.0.0.1:8081
# oidc mode only: project and region for Cloud Tasks continuations.
FIRRA_GCP_PROJECT_ID=
FIRRA_GCP_REGION=europe-west3
# oidc mode only: worker URL (token audience) and the tasks-invoker service account.
FIRRA_TASK_OIDC_AUDIENCE=
FIRRA_TASK_INVOKER_EMAIL=
# Token encryption KEK: cloud (Cloud KMS, staging/prod) | local (static key, local/test only).
FIRRA_KMS_MODE=local
# local mode only: 64 hex characters. Generate: openssl rand -hex 32
FIRRA_LOCAL_KEK_HEX=
# cloud mode only: projects/<p>/locations/europe-west3/keyRings/firra/cryptoKeys/token-kek
FIRRA_KMS_KEY_NAME=
# Raw payload store: GCS bucket (staging/prod) or a local directory (local/test only). Use an
# absolute path when uploading exports locally (the api's LOCAL_RAW_DIR must match).
FIRRA_RAW_BUCKET=
FIRRA_LOCAL_RAW_DIR=.local/raw
# Google OAuth client for Gmail/Calendar connections (optional locally).
FIRRA_GOOGLE_CLIENT_ID=
FIRRA_GOOGLE_CLIENT_SECRET=
# Service account used for Google domain-wide delegation (staging/prod).
FIRRA_WORKER_SERVICE_ACCOUNT=
# Microsoft Entra app for Outlook mail/calendar (delegated + application permissions; optional locally).
FIRRA_MICROSOFT_CLIENT_ID=
FIRRA_MICROSOFT_CLIENT_SECRET=
# Push notifications (optional; the 15-minute sweep works without them). Gmail publishes to this
# Pub/Sub topic; Graph posts change notifications to the api (must be publicly reachable HTTPS).
FIRRA_GMAIL_PUSH_TOPIC=
FIRRA_MICROSOFT_NOTIFICATION_URL=
# Vertex AI Gemini (P2). Location must be the EU multi-region `eu` or an europe-* region; models
# are resolved only in firra/llm/models.py. Leave empty locally: tests fake every model call.
FIRRA_VERTEX_LOCATION=eu
# Optional separate EU location for embeddings only (same pattern). Google lists the embedding
# model for regions such as europe-west3 but not for the `eu` multi-region; empty = same as above.
FIRRA_VERTEX_EMBED_LOCATION=
# metadata (default); gcloud is allowed only for local/test evals.
FIRRA_VERTEX_TOKEN_SOURCE=metadata
# Optional positive USD limit that can only reduce the normal monthly/backfill budget.
# Set equal to FIRRA_EVAL_BUDGET_USD when starting an eval worker.
FIRRA_LLM_HARD_CAP_USD=
FIRRA_MODEL_EXTRACT=gemini-3.5-flash-lite
FIRRA_MODEL_SYNTH=gemini-3.8-flash
FIRRA_MODEL_EMBED=gemini-embedding-001
# Synthetic dataset generation and evals only (run locally or in the weekly evals workflow).
FIRRA_MODEL_SYNTHDATA=gemini-3.8-flash
# Directory of versioned prompts (services/worker/prompts); the container sets /app/prompts.
# FIRRA_PROMPTS_DIR=
# Directory of rule configuration (services/worker/config); the container sets /app/config.
# FIRRA_CONFIG_DIR=
FIRRA_EVAL_BUDGET_USD=5
# Extraction on ingested records (paid Gemini calls). Off unless explicitly enabled.
FIRRA_PROCESSING_ENABLED=false
FIRRA_TASK_TIME_BUDGET_SECONDS=480
FIRRA_SENTRY_DSN=
FIRRA_RELEASE=dev

# --- supabase CLI (optional local OAuth; enable providers in supabase/config.toml) ---------
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
SUPABASE_AUTH_EXTERNAL_AZURE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_AZURE_SECRET=
