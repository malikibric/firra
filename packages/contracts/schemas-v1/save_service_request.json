{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "description": {
      "default": "",
      "type": "string",
      "maxLength": 1000
    },
    "keywords": {
      "default": [],
      "maxItems": 20,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1000
      }
    }
  },
  "required": [
    "name",
    "description",
    "keywords"
  ],
  "additionalProperties": false,
  "description": "Keywords are normalized and deduplicated; joined input is at most 1000 characters.",
  "title": "SaveServiceRequest",
  "$id": "https://firra.app/contracts/v1/save_service_request.json"
}
