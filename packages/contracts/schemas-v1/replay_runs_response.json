{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "items": {
      "maxItems": 500,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "window_start": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "window_end": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "step_days": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "status": {
            "type": "string",
            "enum": [
              "queued",
              "running",
              "succeeded",
              "failed"
            ]
          },
          "finished_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ]
          },
          "totals": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "losses": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "losses_detected_30d": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "median_lead_days": {
                    "type": [
                      "number",
                      "null"
                    ]
                  },
                  "retained": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "retained_with_elevated": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "false_alarm_client_weeks_per_10_clients_per_month": {
                    "type": "number",
                    "minimum": 0
                  },
                  "flicker": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  }
                },
                "required": [
                  "losses",
                  "losses_detected_30d",
                  "median_lead_days",
                  "retained",
                  "retained_with_elevated",
                  "false_alarm_client_weeks_per_10_clients_per_month",
                  "flicker"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          },
          "narrated": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "window_start",
          "window_end",
          "step_days",
          "status",
          "finished_at",
          "totals",
          "narrated"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "generated_at",
    "items"
  ],
  "additionalProperties": false,
  "title": "ReplayRunsResponse",
  "$id": "https://firra.app/contracts/v1/replay_runs_response.json"
}
