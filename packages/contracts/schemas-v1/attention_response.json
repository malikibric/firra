{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "items": {
      "maxItems": 150,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "client_id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "active",
              "churned",
              "prospect"
            ]
          },
          "policy": {
            "type": "string",
            "enum": [
              "full",
              "metadata_only"
            ]
          },
          "as_of": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "risk_state": {
            "type": "string",
            "enum": [
              "stable",
              "watch",
              "elevated",
              "high"
            ]
          },
          "previous_risk_state": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "stable",
                  "watch",
                  "elevated",
                  "high"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "state_since": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "expansion_state": {
            "type": "string",
            "enum": [
              "none",
              "hypothesis",
              "strong"
            ]
          },
          "strength": {
            "type": "string",
            "enum": [
              "weak",
              "moderate",
              "strong"
            ]
          },
          "play": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 40
              },
              {
                "type": "null"
              }
            ]
          },
          "days_to_notice": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              {
                "type": "null"
              }
            ]
          },
          "drivers": {
            "maxItems": 2,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "maxLength": 60
                },
                "family": {
                  "anyOf": [
                    {
                      "type": "string",
                      "maxLength": 40
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "severity": {
                  "type": "string",
                  "enum": [
                    "low",
                    "medium",
                    "high"
                  ]
                },
                "basis": {
                  "type": "string",
                  "enum": [
                    "evidence",
                    "metadata"
                  ]
                },
                "occurred_at": {
                  "anyOf": [
                    {
                      "type": "string",
                      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "primary": {
                  "type": "boolean"
                },
                "evidence_count": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                }
              },
              "required": [
                "type",
                "family",
                "severity",
                "basis",
                "occurred_at",
                "primary",
                "evidence_count"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "client_id",
          "name",
          "status",
          "policy",
          "as_of",
          "risk_state",
          "previous_risk_state",
          "state_since",
          "expansion_state",
          "strength",
          "play",
          "days_to_notice",
          "drivers"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "generated_at",
    "items"
  ],
  "additionalProperties": false,
  "title": "AttentionResponse",
  "$id": "https://firra.app/contracts/v1/attention_response.json"
}
