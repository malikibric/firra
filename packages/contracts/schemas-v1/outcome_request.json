{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "event": {
      "type": "string",
      "enum": [
        "renewed",
        "price_increase",
        "downgrade",
        "expanded",
        "churned",
        "referral"
      ]
    },
    "occurred_at": {
      "type": "string",
      "format": "date"
    },
    "notice_at": {
      "anyOf": [
        {
          "type": "string",
          "format": "date"
        },
        {
          "type": "null"
        }
      ]
    },
    "first_known_at": {
      "anyOf": [
        {
          "type": "string",
          "format": "date"
        },
        {
          "type": "null"
        }
      ]
    },
    "amount_change": {
      "anyOf": [
        {
          "type": "number",
          "minimum": -9999999999.99,
          "maximum": 9999999999.99
        },
        {
          "type": "null"
        }
      ]
    },
    "currency": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "note": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 1000
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "event",
    "occurred_at"
  ],
  "additionalProperties": false,
  "title": "OutcomeRequest",
  "$id": "https://firra.app/contracts/v1/outcome_request.json"
}
