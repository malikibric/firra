{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "items": {
      "maxItems": 10,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "calendar_event_id": {
            "type": "string",
            "format": "uuid"
          },
          "client_id": {
            "type": "string",
            "format": "uuid"
          },
          "client_name": {
            "type": "string"
          },
          "policy": {
            "type": "string",
            "enum": [
              "full",
              "metadata_only"
            ]
          },
          "starts_at": {
            "type": "string",
            "format": "date-time"
          },
          "basis": {
            "type": "string",
            "enum": [
              "evidence",
              "metadata"
            ]
          },
          "since_last_meeting": {
            "type": "object",
            "properties": {
              "records": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "last_held_at": {
                "anyOf": [
                  {
                    "type": "string",
                    "format": "date-time"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "records",
              "last_held_at"
            ],
            "additionalProperties": false
          },
          "open_commitments": {
            "maxItems": 5,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "side": {
                  "type": "string",
                  "enum": [
                    "firm",
                    "client"
                  ]
                },
                "text": {
                  "type": "string",
                  "maxLength": 500
                },
                "due": {
                  "anyOf": [
                    {
                      "type": "string",
                      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "late": {
                  "type": "boolean"
                },
                "evidence_ids": {
                  "maxItems": 5,
                  "type": "array",
                  "items": {
                    "type": "string",
                    "format": "uuid"
                  }
                }
              },
              "required": [
                "side",
                "text",
                "due",
                "late",
                "evidence_ids"
              ],
              "additionalProperties": false
            }
          },
          "unresolved_complaints": {
            "maxItems": 5,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "subtype": {
                  "type": "string",
                  "maxLength": 40
                },
                "text": {
                  "type": "string",
                  "maxLength": 500
                },
                "evidence_ids": {
                  "maxItems": 5,
                  "type": "array",
                  "items": {
                    "type": "string",
                    "format": "uuid"
                  }
                }
              },
              "required": [
                "subtype",
                "text",
                "evidence_ids"
              ],
              "additionalProperties": false
            }
          },
          "stakeholder_changes": {
            "maxItems": 5,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "text": {
                  "type": "string",
                  "maxLength": 500
                },
                "evidence_ids": {
                  "maxItems": 5,
                  "type": "array",
                  "items": {
                    "type": "string",
                    "format": "uuid"
                  }
                }
              },
              "required": [
                "text",
                "evidence_ids"
              ],
              "additionalProperties": false
            }
          },
          "renewal": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "date": {
                    "type": "string",
                    "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                  },
                  "days_to_notice": {
                    "anyOf": [
                      {
                        "type": "integer",
                        "minimum": -9007199254740991,
                        "maximum": 9007199254740991
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "required": [
                  "date",
                  "days_to_notice"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          },
          "unknowns": {
            "maxItems": 10,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "code": {
                  "type": "string",
                  "maxLength": 60
                },
                "detail": {
                  "type": "string",
                  "maxLength": 200
                }
              },
              "required": [
                "code",
                "detail"
              ],
              "additionalProperties": false
            }
          },
          "questions": {
            "maxItems": 3,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "text": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 400
                },
                "basis": {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "type": "string",
                      "enum": [
                        "complaint",
                        "commitment",
                        "stakeholder",
                        "renewal",
                        "unknown"
                      ]
                    },
                    "ref": {
                      "type": "string",
                      "maxLength": 80
                    }
                  },
                  "required": [
                    "kind",
                    "ref"
                  ],
                  "additionalProperties": false
                }
              },
              "required": [
                "text",
                "basis"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "id",
          "calendar_event_id",
          "client_id",
          "client_name",
          "policy",
          "starts_at",
          "basis",
          "since_last_meeting",
          "open_commitments",
          "unresolved_complaints",
          "stakeholder_changes",
          "renewal",
          "unknowns",
          "questions"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "generated_at",
    "items"
  ],
  "additionalProperties": false,
  "title": "MeetingsResponse",
  "$id": "https://firra.app/contracts/v1/meetings_response.json"
}
