{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "items": {
      "maxItems": 100,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "client_id": {
            "type": "string",
            "format": "uuid"
          },
          "client_name": {
            "type": "string",
            "maxLength": 200
          },
          "week": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "kind": {
            "type": "string",
            "enum": [
              "risk",
              "margin",
              "pricing",
              "growth",
              "external",
              "commitment",
              "state_change",
              "commitment_watch",
              "expansion"
            ]
          },
          "importance": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "fyi",
                  "attention",
                  "important"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "surfaced_on": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "title": {
            "type": "string"
          },
          "body": {
            "type": "string"
          },
          "play": {
            "type": "string"
          },
          "strength": {
            "type": "string",
            "enum": [
              "weak",
              "moderate",
              "strong"
            ]
          },
          "priority": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "status": {
            "type": "string",
            "enum": [
              "new",
              "done",
              "dismissed"
            ]
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid"
            }
          },
          "feedback": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "verdict": {
                    "type": "string",
                    "enum": [
                      "useful",
                      "already_known",
                      "wrong",
                      "not_now"
                    ]
                  },
                  "action": {
                    "anyOf": [
                      {
                        "type": "string",
                        "enum": [
                          "taken",
                          "planned",
                          "none"
                        ]
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "note": {
                    "anyOf": [
                      {
                        "type": "string",
                        "maxLength": 1000
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "required": [
                  "verdict",
                  "action",
                  "note"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "id",
          "client_id",
          "client_name",
          "week",
          "kind",
          "title",
          "body",
          "play",
          "strength",
          "priority",
          "status",
          "created_at",
          "evidence_ids",
          "feedback"
        ],
        "additionalProperties": false
      }
    },
    "next_cursor": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "items",
    "next_cursor"
  ],
  "additionalProperties": false,
  "title": "DecisionsResponse",
  "$id": "https://firra.app/contracts/v1/decisions_response.json"
}
