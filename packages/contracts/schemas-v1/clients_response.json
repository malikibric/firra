{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "items": {
      "maxItems": 500,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string",
            "maxLength": 200
          },
          "status": {
            "type": "string",
            "enum": [
              "active",
              "churned",
              "prospect"
            ]
          },
          "policy": {
            "type": "string",
            "enum": [
              "full",
              "metadata_only"
            ]
          },
          "mrr": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0
              },
              {
                "type": "null"
              }
            ]
          },
          "currency": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[A-Z]{3}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "renewal_date": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "notice_period_days": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              {
                "type": "null"
              }
            ]
          },
          "assessment": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "risk_state": {
                    "type": "string",
                    "enum": [
                      "stable",
                      "watch",
                      "elevated",
                      "high"
                    ]
                  },
                  "state_since": {
                    "type": "string",
                    "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                  },
                  "expansion_state": {
                    "type": "string",
                    "enum": [
                      "none",
                      "hypothesis",
                      "strong"
                    ]
                  },
                  "play": {
                    "anyOf": [
                      {
                        "type": "string",
                        "maxLength": 40
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "as_of": {
                    "type": "string",
                    "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                  }
                },
                "required": [
                  "risk_state",
                  "state_since",
                  "expansion_state",
                  "play",
                  "as_of"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "id",
          "name",
          "status",
          "policy",
          "mrr",
          "currency",
          "renewal_date",
          "notice_period_days",
          "assessment"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "generated_at",
    "items"
  ],
  "additionalProperties": false,
  "title": "ClientsResponse",
  "$id": "https://firra.app/contracts/v1/clients_response.json"
}
