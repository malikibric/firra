{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "client_id": {
      "type": "string",
      "format": "uuid"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "owner_side": {
            "type": "string",
            "enum": [
              "client",
              "firm"
            ]
          },
          "text": {
            "type": "string",
            "maxLength": 500
          },
          "due_date": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "open",
              "late"
            ]
          },
          "evidence_ids": {
            "maxItems": 5,
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid"
            }
          }
        },
        "required": [
          "owner_side",
          "text",
          "due_date",
          "status"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "generated_at",
    "client_id",
    "items"
  ],
  "additionalProperties": false,
  "title": "McpCommitments",
  "$id": "https://firra.app/contracts/v1/mcp_commitments.json"
}
