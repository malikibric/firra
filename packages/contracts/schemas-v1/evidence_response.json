{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "quote": {
            "type": "string"
          },
          "locator": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {}
          },
          "deep_link": {
            "type": [
              "string",
              "null"
            ]
          },
          "occurred_at": {
            "type": "string",
            "format": "date-time"
          },
          "author_name": {
            "type": [
              "string",
              "null"
            ]
          },
          "author_role": {
            "type": [
              "string",
              "null"
            ]
          },
          "subject": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 120
              },
              {
                "type": "null"
              }
            ]
          },
          "source_ref": {
            "type": "string",
            "minLength": 8,
            "maxLength": 8
          },
          "client_id": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": [
          "id",
          "quote",
          "locator",
          "deep_link",
          "occurred_at",
          "author_name",
          "author_role",
          "subject",
          "source_ref",
          "client_id"
        ],
        "additionalProperties": false
      }
    },
    "next_cursor": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "items",
    "next_cursor"
  ],
  "additionalProperties": false,
  "title": "EvidenceResponse",
  "$id": "https://firra.app/contracts/v1/evidence_response.json"
}
