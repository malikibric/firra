  },
  "devDependencies": {
    "@firra/config": "workspace:*",
    "@types/node": "^24.19.0",
    "eslint": "^10.11.0",
    "json-schema-to-zod": "^2.8.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^5.0.2"
  }
}
