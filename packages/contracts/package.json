{
  "name": "@firra/contracts",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "codegen": "tsx scripts/generate.ts && tsx scripts/generate-v1.ts",
    "build": "tsc -p tsconfig.build.json",
