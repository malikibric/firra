{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://firra.app/contracts/local/relay_settings.json",
  "title": "RelaySettings",
  "description": "GET/PUT /local/relay: the relay address and the connector links created for claude.ai and ChatGPT (docs/plans/local/relay.md section 8). Secrets are never returned.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "relay_url",
    "state",
    "links"
  ],
  "properties": {
    "relay_url": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 200,
      "pattern": "^https://[A-Za-z0-9.-]+(:[0-9]{1,5})?$"
    },
    "state": {
      "enum": [
        "not_registered",
        "offline",
        "connecting",
        "online"
      ]
    },
    "links": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "scopes",
          "created_at"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 60
          },
          "scopes": {
            "type": "array",
            "minItems": 1,
            "maxItems": 2,
            "uniqueItems": true,
            "items": {
              "enum": [
                "intelligence",
                "sources"
              ]
            }
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    }
  }
}
